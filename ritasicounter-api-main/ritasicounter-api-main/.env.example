# Otomatis terisi kalau pakai Railway Postgres plugin (atau isi manual connection string Postgres kamu)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Zona waktu server. Pilihan: Asia/Jakarta (WIB) / Asia/Makassar (WITA) / Asia/Jayapura (WIT)
TZ_NAME=Asia/Makassar

# WAJIB diisi manual, bebas string acak yang panjang & rahasia (dipakai buat sign session login)
JWT_SECRET=ganti-dengan-string-acak-yang-panjang-dan-rahasia
